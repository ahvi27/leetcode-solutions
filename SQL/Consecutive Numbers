-- Create table
CREATE TABLE Logs (
    id INT,
    num INT
);

-- Insert sample data
INSERT INTO Logs VALUES
(1, 1),
(2, 1),
(3, 1),
(4, 2),
(5, 1);


-- Solution
SELECT DISTINCT l1.num AS ConsecutiveNums
FROM Logs l1
JOIN Logs l2
    ON l1.id = l2.id + 1
JOIN Logs l3
    ON l2.id = l3.id + 1
WHERE l1.num = l2.num
AND l2.num = l3.num;