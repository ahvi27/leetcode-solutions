#include <iostream>
#include <vector>
#include <unordered_set>
#include <algorithm>
using namespace std;

int uniqueXorTriplets(vector<int>& nums) {
    unordered_set<int> st(nums.begin(), nums.end());
    vector<int> vals(st.begin(), st.end());

    const int MAXX = 2048;

    // Store all possible XORs of two values
    vector<bool> pairXor(MAXX, false);
    for (int x : vals) {
        for (int y : vals) {
            pairXor[x ^ y] = true;
        }
    }

    // Store all possible XORs of three values
    vector<bool> ans(MAXX, false);
    for (int v = 0; v < MAXX; v++) {
        if (!pairXor[v]) continue;
        for (int z : vals) {
            ans[v ^ z] = true;
        }
    }

    return count(ans.begin(), ans.end(), true);
}

int main() {
    int n;
    cin >> n;

    vector<int> nums(n);
    for (int i = 0; i < n; i++) {
        cin >> nums[i];
    }

    cout << uniqueXorTriplets(nums) << endl;

    return 0;
}