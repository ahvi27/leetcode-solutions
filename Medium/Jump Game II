#include <bits/stdc++.h>
using namespace std;


class Solution {
public:
    int jump(vector<int>& nums) {

        int jumps = 0;
        int farthest = 0;
        int currentEnd = 0;


        for (int i = 0; i < nums.size() - 1; i++) {

            farthest = max(
                farthest,
                i + nums[i]
            );


            if (i == currentEnd) {

                jumps++;

                currentEnd = farthest;
            }
        }


        return jumps;
    }
};


int main() {

    ios::sync_with_stdio(false);
    cin.tie(nullptr);


    int n;
    cin >> n;


    vector<int> nums(n);


    for (int i = 0; i < n; i++) {
        cin >> nums[i];
    }


    Solution sol;


    cout << sol.jump(nums);


    return 0;
}