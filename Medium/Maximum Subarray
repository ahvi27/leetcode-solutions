#include <bits/stdc++.h>
using namespace std;


class Solution {
public:

    int maxSubArray(vector<int>& nums) {

        int current = nums[0];
        int best = nums[0];


        for (int i = 1; i < nums.size(); i++) {

            current = max(
                nums[i],
                current + nums[i]
            );


            best = max(
                best,
                current
            );
        }


        return best;
    }
};



int main() {

    ios::sync_with_stdio(false);
    cin.tie(nullptr);


    int n;
    cin >> n;


    vector<int> nums(n);


    for (int i = 0; i < n; i++) {
        cin >> nums[i];
    }


    Solution sol;


    cout << sol.maxSubArray(nums);


    return 0;
}