#include <iostream>
#include <string>

using namespace std;


int numSteps(string s) {


    int steps = 0;
    int carry = 0;



    for (int i = s.size() - 1; i > 0; i--) {


        int bit = (s[i] - '0') + carry;



        if (bit == 1) {

            // Add 1
            steps++;

            carry = 1;

        }



        // Divide by 2
        steps++;

    }



    if (carry == 1)
        steps++;



    return steps;

}



int main() {


    string s = "1101";


    cout << numSteps(s);



    return 0;
}