class Solution {
public:
    vector<string> ans;
    string path;

    vector<string> mp = {
        "", "", "abc", "def", "ghi",
        "jkl", "mno", "pqrs", "tuv", "wxyz"
    };

    void dfs(string &digits, int idx) {
        if (idx == digits.size()) {
            ans.push_back(path);
            return;
        }

        for (char c : mp[digits[idx] - '0']) {
            path.push_back(c);
            dfs(digits, idx + 1);
            path.pop_back();
        }
    }

    vector<string> letterCombinations(string digits) {
        if (digits.empty()) return {};

        dfs(digits, 0);
        return ans;
    }
};