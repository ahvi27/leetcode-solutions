#include <iostream>

using namespace std;


int concatenatedBinary(int n) {


    const long long MOD = 1000000007;


    long long ans = 0;


    int bits = 0;



    for(int i = 1; i <= n; i++) {


        // i is power of two
        if((i & (i - 1)) == 0) {
            bits++;
        }



        ans = ((ans << bits) % MOD + i) % MOD;

    }



    return ans;

}



int main() {


    int n = 3;


    cout << concatenatedBinary(n);


    return 0;
}