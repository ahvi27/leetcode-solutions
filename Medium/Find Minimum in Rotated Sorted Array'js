var findMin = function(nums) {
    let left = 0;
    let right = nums.length - 1;

    while (left < right) {
        let mid = Math.floor((left + right) / 2);

        if (nums[mid] > nums[right]) {
            // Minimum is on the right side
            left = mid + 1;
        } else {
            // Minimum is at mid or left side
            right = mid;
        }
    }

    return nums[left];
};