#include <bits/stdc++.h>
using namespace std;


class Solution {
public:

    vector<vector<int>> ans;


    void backtrack(
        vector<int>& nums,
        vector<int>& current,
        vector<bool>& used
    ) {

        if (current.size() == nums.size()) {

            ans.push_back(current);

            return;
        }


        for (int i = 0; i < nums.size(); i++) {


            if (used[i])
                continue;


            used[i] = true;

            current.push_back(nums[i]);


            backtrack(
                nums,
                current,
                used
            );


            current.pop_back();

            used[i] = false;
        }
    }



    vector<vector<int>> permute(vector<int>& nums) {

        vector<int> current;

        vector<bool> used(
            nums.size(),
            false
        );


        backtrack(
            nums,
            current,
            used
        );


        return ans;
    }
};



int main() {

    ios::sync_with_stdio(false);
    cin.tie(nullptr);


    int n;

    cin >> n;


    vector<int> nums(n);


    for (int i = 0; i < n; i++) {
        cin >> nums[i];
    }


    Solution sol;


    vector<vector<int>> result =
        sol.permute(nums);



    for (auto &v : result) {

        cout << "[";

        for (int i = 0; i < v.size(); i++) {

            cout << v[i];

            if (i + 1 < v.size())
                cout << ",";
        }

        cout << "]\n";
    }


    return 0;
}