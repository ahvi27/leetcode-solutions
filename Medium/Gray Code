#include <iostream>
#include <vector>
using namespace std;

vector<int> grayCode(int n) {
    vector<int> ans;
    int total = 1 << n;

    for (int i = 0; i < total; i++) {
        ans.push_back(i ^ (i >> 1));
    }

    return ans;
}

int main() {
    int n;
    cout << "Enter n: ";
    cin >> n;

    vector<int> result = grayCode(n);

    cout << "Gray Code Sequence: ";
    for (int num : result) {
        cout << num << " ";
    }
    cout << endl;

    return 0;
}