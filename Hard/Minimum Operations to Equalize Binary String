#include <iostream>
#include <vector>
#include <set>
#include <queue>

using namespace std;


int minOperations(string s, int k) {


    int n = s.size();


    int zeros = 0;


    for(char c : s) {

        if(c == '0')
            zeros++;

    }



    if(zeros == 0)
        return 0;



    vector<set<int>> unvisited(2);



    for(int i = 0; i <= n; i++) {

        unvisited[i % 2].insert(i);

    }



    unvisited[zeros % 2].erase(zeros);



    queue<int> q;


    q.push(zeros);



    int steps = 0;



    while(!q.empty()) {


        int size = q.size();



        while(size--) {


            int cur = q.front();

            q.pop();



            if(cur == 0)
                return steps;



            int left = cur + k - 2 * min(cur, k);


            int right = cur + k - 2 * max(k - n + cur, 0);



            auto &st = unvisited[left % 2];


            auto it = st.lower_bound(left);



            while(it != st.end() && *it <= right) {


                q.push(*it);


                it = st.erase(it);

            }

        }


        steps++;

    }



    return -1;

}



int main() {


    string s = "0101";

    int k = 3;


    cout << minOperations(s,k);


    return 0;
}