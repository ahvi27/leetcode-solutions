#include <bits/stdc++.h>
using namespace std;

class Solution {
public:

    struct Mat {
        static constexpr long long NEG = -1000000000000000LL;

        long long a[5][5];

        Mat(bool identity = false) {
            for (int i = 0; i < 5; i++) {
                for (int j = 0; j < 5; j++) {
                    a[i][j] = (identity && i == j) ? 0 : NEG;
                }
            }
        }
    };


    vector<Mat> tree;
    string s;


    Mat mergeMat(const Mat &A, const Mat &B) {

        Mat C;

        for (int i = 0; i < 5; i++) {
            for (int k = 0; k < 5; k++) {

                long long best = Mat::NEG;

                for (int j = 0; j < 5; j++) {

                    if (A.a[i][j] == Mat::NEG ||
                        B.a[j][k] == Mat::NEG)
                        continue;

                    best = max(
                        best,
                        A.a[i][j] + B.a[j][k]
                    );
                }

                C.a[i][k] = best;
            }
        }

        return C;
    }



    Mat makeNode(char c) {

        Mat m;

        if (c == '0') {

            m.a[0][0] = 0;

            m.a[0][1] = 1;

            m.a[1][1] = 1;

            m.a[2][3] = 1;

            m.a[3][3] = 1;

            m.a[4][4] = 0;

        } 
        else {

            m.a[0][0] = 0;

            m.a[1][2] = 0;

            m.a[2][2] = 0;

            m.a[3][4] = 0;

            m.a[4][4] = 0;
        }

        return m;
    }



    void build(int node, int l, int r) {

        if (l == r) {
            tree[node] = makeNode(s[l]);
            return;
        }

        int mid = (l + r) / 2;

        build(node * 2, l, mid);
        build(node * 2 + 1, mid + 1, r);

        tree[node] = mergeMat(
            tree[node * 2],
            tree[node * 2 + 1]
        );
    }



    void query(
        int node,
        int l,
        int r,
        int ql,
        int qr,
        Mat &res,
        bool &hasValue
    ) {

        if (qr < l || r < ql)
            return;


        if (ql <= l && r <= qr) {

            if (!hasValue) {
                res = tree[node];
                hasValue = true;
            }
            else {
                res = mergeMat(
                    res,
                    tree[node]
                );
            }

            return;
        }


        int mid = (l + r) / 2;


        query(
            node * 2,
            l,
            mid,
            ql,
            qr,
            res,
            hasValue
        );


        query(
            node * 2 + 1,
            mid + 1,
            r,
            ql,
            qr,
            res,
            hasValue
        );
    }



    vector<int> maxActiveSectionsAfterTrade(
        string str,
        vector<vector<int>>& queries
    ) {

        s = str;

        int n = s.size();

        tree.assign(4 * n, Mat());

        build(1, 0, n - 1);


        vector<int> pref(n + 1, 0);

        for (int i = 0; i < n; i++) {
            pref[i + 1] =
                pref[i] + (s[i] == '1');
        }


        int totalOnes = pref[n];

        vector<int> ans;


        for (auto &q : queries) {

            int l = q[0];
            int r = q[1];


            Mat res;

            bool hasValue = false;


            query(
                1,
                0,
                n - 1,
                l,
                r,
                res,
                hasValue
            );


            long long gain = max(
                res.a[0][3],
                res.a[0][4]
            );


            if (gain < 0)
                gain = 0;


            int insideOnes =
                pref[r + 1] - pref[l];


            int outsideOnes =
                totalOnes - insideOnes;


            ans.push_back(
                outsideOnes +
                insideOnes +
                (int)gain
            );
        }


        return ans;
    }
};



int main() {

    ios::sync_with_stdio(false);
    cin.tie(nullptr);


    Solution sol;


    string s;
    cin >> s;


    int q;
    cin >> q;


    vector<vector<int>> queries(q, vector<int>(2));


    for (int i = 0; i < q; i++) {
        cin >> queries[i][0]
            >> queries[i][1];
    }


    vector<int> result =
        sol.maxActiveSectionsAfterTrade(
            s,
            queries
        );


    for (int x : result) {
        cout << x << " ";
    }


    return 0;
}