#include <bits/stdc++.h>
using namespace std;


class Solution {
public:

    vector<vector<string>> ans;


    void solve(
        int row,
        int n,
        vector<string>& board,
        vector<bool>& col,
        vector<bool>& diag1,
        vector<bool>& diag2
    ) {


        if (row == n) {

            ans.push_back(board);

            return;
        }


        for (int c = 0; c < n; c++) {


            if (col[c] ||
                diag1[row - c + n] ||
                diag2[row + c])
                continue;



            board[row][c] = 'Q';


            col[c] = true;

            diag1[row - c + n] = true;

            diag2[row + c] = true;



            solve(
                row + 1,
                n,
                board,
                col,
                diag1,
                diag2
            );



            board[row][c] = '.';


            col[c] = false;

            diag1[row - c + n] = false;

            diag2[row + c] = false;
        }
    }




    vector<vector<string>> solveNQueens(int n) {


        vector<string> board(
            n,
            string(n, '.')
        );


        vector<bool> col(
            n,
            false
        );


        vector<bool> diag1(
            2 * n,
            false
        );


        vector<bool> diag2(
            2 * n,
            false
        );



        solve(
            0,
            n,
            board,
            col,
            diag1,
            diag2
        );


        return ans;
    }

};



int main() {


    ios::sync_with_stdio(false);
    cin.tie(nullptr);



    int n;

    cin >> n;



    Solution sol;


    vector<vector<string>> result =
        sol.solveNQueens(n);



    for (auto &board : result) {


        for (auto &row : board) {

            cout << row << "\n";
        }


        cout << "\n";
    }



    return 0;
}