class Solution {
public:
    vector<vector<int>> mx, mn;
    vector<int> lg;

    void build(vector<int>& nums) {
        int n = nums.size();
        int K = 20;

        mx.assign(n, vector<int>(K));
        mn.assign(n, vector<int>(K));
        lg.assign(n + 1, 0);

        for (int i = 2; i <= n; i++)
            lg[i] = lg[i / 2] + 1;

        for (int i = 0; i < n; i++) {
            mx[i][0] = nums[i];
            mn[i][0] = nums[i];
        }

        for (int j = 1; j < K; j++) {
            for (int i = 0; i + (1 << j) <= n; i++) {
                mx[i][j] = max(mx[i][j - 1],
                               mx[i + (1 << (j - 1))][j - 1]);

                mn[i][j] = min(mn[i][j - 1],
                               mn[i + (1 << (j - 1))][j - 1]);
            }
        }
    }

    int queryMax(int l, int r) {
        int j = lg[r - l + 1];
        return max(mx[l][j],
                   mx[r - (1 << j) + 1][j]);
    }

    int queryMin(int l, int r) {
        int j = lg[r - l + 1];
        return min(mn[l][j],
                   mn[r - (1 << j) + 1][j]);
    }

    long long value(int l, int r) {
        return (long long)queryMax(l, r) -
               (long long)queryMin(l, r);
    }

    long long maxTotalValue(vector<int>& nums, int k) {
        int n = nums.size();

        build(nums);

        priority_queue<tuple<long long,int,int>> pq;

        // Put nums[l..n-1] for every l
        for (int l = 0; l < n; l++) {
            pq.push({value(l, n - 1), l, n - 1});
        }

        long long ans = 0;

        while (k--) {
            auto [val, l, r] = pq.top();
            pq.pop();

            ans += val;

            if (r > l) {
                pq.push({value(l, r - 1), l, r - 1});
            }
        }

        return ans;
    }
};